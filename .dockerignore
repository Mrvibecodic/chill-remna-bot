# Не тащим в build-контекст лишнее — образ собирается быстрее и чище.
.git
.gitignore
.env
*.env
!.env.example
# данные/секреты, если запускали локально без Docker
data/
*.db
*.db-wal
*.db-shm
secret.key
bootstrap.json
# документация в образе не нужна, кроме обязательных уведомлений о лицензиях
*.md
!THIRD-PARTY-NOTICES.md
# сайт документации собирается отдельно (workflow pages) и в образ не едет:
# 6+ МБ скриншотов в контексте сборки заставляли пересобирать бинарник с нуля
# на двух архитектурах от правки любой картинки
site/
.github/
scripts/
# артефакты
bot
/out
.gotool/
